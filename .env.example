# ─────────────────────────────────────────────────────────────
# TradingAgents-KR 설정 파일 예시
#   이 파일을 .env로 복사해서 쓰세요. (.env는 절대 공유/업로드하지 마세요)
#
# ⚠️ API 키는 여기에 적지 않는 것을 권장합니다.
#    대신 아래 명령으로 Windows 자격 증명 관리자에 안전하게 저장하세요:
#       python cli.py set-key gemini      (또는 anthropic)
#    키 상태 확인:  python cli.py key-status
# ─────────────────────────────────────────────────────────────

# 사용할 LLM 프로바이더: anthropic 또는 gemini
LLM_PROVIDER=anthropic

ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-lite-latest
# 계정에 Search grounding 쿼터/결제가 없다면 false로 (트레이더 단계 웹검색 비활성화)
GEMINI_WEB_SEARCH_ENABLED=true

DEBATE_MAX_ROUNDS=2
MEMORY_DB_PATH=./memory_store.json

# (비권장) 자격 증명 저장소를 쓸 수 없는 환경에서만 아래에 키를 적으세요.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# 미국장 별도 USD 모의계좌 (실제 주문 없음). Alpaca paper 키는 set-key로 저장:
# python cli.py set-key alpaca_id
# python cli.py set-key alpaca_secret
# US_PAPER_INITIAL_USD=10000
# US_SEC_USER_AGENT=SignalLab research your-email@example.com
# US_AUTO_ANALYZE=false       # true면 미국장 개장 중 --cycle에서 시간별 유료 LLM 분석
# US_PUBLIC_SUMMARY=false     # 공개 정적 페이지에 미국 계좌 요약 게시 (원시 호가 제외)

# (V3.13) 뉴스 출처. auto = 네이버 검색 API 키(naver_id/naver_secret, start.bat 8번)가 있으면 공식 API, 없으면 증권 모바일 API
NEWS_SOURCE=auto
NEWS_SEARCH_DISPLAY=40
# hub = NAVER API HUB(네이버 클라우드) 키 / legacy = 구 개발자센터 키
NAVER_SEARCH_MODE=hub
# 키 자체는 여기 쓰지 말고 start.bat 8번(자격 증명 관리자)으로 등록: NAVER_CLIENT_ID / NAVER_CLIENT_SECRET
